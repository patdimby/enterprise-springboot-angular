# Variables docker-compose (copier ce fichier en .env et adapter)
# ------------------------------------------------------------------

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=enterprise
MYSQL_PASSWORD=enterprise

# Backend — secret JWT (OBLIGATOIRE : générer un secret unique en prod, ex.):
#   openssl rand -base64 64
APP_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi0yNTZiaXRzIQ==

# CORS — origines autorisées (séparées par des virgules)
APP_CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:4200
